# Every CTest invocation owns new output directories; old replays are never
# overwritten and concurrent/repeated runs cannot consume each other's journal.
string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef nonce)
set(root "${RESULTS}/${CASE}-${stamp}-${nonce}")
file(MAKE_DIRECTORY "${root}")
function(run_checked executable)
  execute_process(COMMAND "${executable}" ${ARGN} RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${executable} failed (${result}); output directory: ${root}")
  endif()
endfunction()
if(CASE STREQUAL "media")
  run_checked("${EXE}" "${root}")
  run_checked("${PLAYBACK}" "${root}/audio.mp4")
elseif(CASE STREQUAL "integration")
  run_checked("${EXE}" "${DLL}" "${DATA}" "${root}")
  run_checked("${EXE}" "${DLL}" "${DATA}" "${root}" recover)
else()
  run_checked("${EXE}" "${root}")
endif()
